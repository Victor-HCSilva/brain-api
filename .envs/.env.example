# ==========================================
# Configurações do Django
# ==========================================
SECRET_KEY=secret_key_111
DEBUG=True
TRUSTED_ORIGINS=localhost,127.0.0.1
LINK_PAGINA=https://google.com

# ==========================================
# Banco de Dados (PostgreSQL)
# ==========================================
# Variáveis que o container do Postgres oficial precisa para criar o banco:
POSTGRES_DB=todo_db
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=todo_secret_pass

# Variáveis que o Django lê para se conectar:
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=todo_secret_pass
DB_HOST=db
DB_PORT=5432

# ==========================================
# Redis e Celery
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_LOCATION=redis://redis:6379/1